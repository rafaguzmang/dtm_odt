                                                <field name="tipo_servicio"/>
                                                <field name="nombre"/>
                                                <field name="cantidad" options='{"type": "number"}'/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Anexos">
                                                <field name="anexos_id" widget="many2many_binary"/>
                                            </page>
                                        </notebook>

                                    </form>
                                </field>

                            </page>
                            <page string="ANEXOS" attrs="{'invisible': [('tipe_order','in',['SK','PD','Pre'])]}">
                                <field name="archivos_id"/>
                            </page>
