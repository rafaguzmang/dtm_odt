                                            <field name="name" invisible="1"></field>
                                        </group>
                                     </form>
                                </field>
                            </page>
                            <page string="SERVICIOS" attrs="{'invisible': [('tipe_order','in',['SK','PD','Pre'])]}">
                                <field name="maquinados_id" attrs="{'readonly': [('retrabajo', '=', True)]}">
                                    <tree>
                                        <field name="tipo_servicio"/>
                                        <field name="nombre"/>
                                        <field name="cantidad"/>
                                        <field name="proveedor"/>
                                        <field name="fecha_solicitud"/>
                                        <field name="fecha_compra"/>
                                        <field name="fecha_entrada"/>
                                    </tree>
                                    <form>
                                        <div class="flex-fechas">
