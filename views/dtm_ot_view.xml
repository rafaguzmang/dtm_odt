<!--                                            <tree editable="bottom">-->
<!--                                                <field name="liga"/>-->
<!--                                            </tree>-->
<!--                                        </field>-->
<!--                                    </div>-->
<!--                                </div>-->
<!--                            </page>-->
                            <page string="LTP 6032"  attrs="{'invisible': [('tipe_order','in',['SK','PD','Pre','COT'])]}">
                                 <div style="display:flex;">
                                    <div style="display:flex;width: 50%">
                                        <field name="tubos_id" widget="many2many_binary" attrs="{'readonly': ['|',('firma_ingenieria', '!=', False),('usuario', '!=', 'ingenieria1@dtmindustry.com')]}" />
                                    </div>
                                    <div style="width: 50%">
                                        <field name="ligas_tubos_id"  >
                                            <tree editable="bottom">
                                                <field name="liga"/>
                                            </tree>
                                        </field>
                                    </div>
                                </div>

                            </page>
                            <page string="NOTAS">
                                <field name="notes"/>
                            </page>
                            <page string="PO" attrs="{'invisible': ['|',('tipe_order','in',['SK','PD','Pre']),('usuario','=','ingenieria1@dtmindustry.com')]}">
                                <group>
                                    <field name="usuario" invisible="1"/>
                                </group>
                                <field name="orden_compra_pdf" >
                                     <tree>
                                            <field name="name" invisible="0"></field>
                                     </tree>
                                     <form>
                                        <group >
                                            <field name="datas" filename="nombre" widget="pdf_viewer"></field>
                                            <field name="name" invisible="1"></field>
                                        </group>
                                     </form>
                                </field>
                            </page>
                            <page string="ARCHIVOS" attrs="{'invisible': [('usuario','=','ingenieria1@dtmindustry.com')]}">
                                <group>
                                    <field name="usuario" invisible="1"/>
                                </group>
                                <field name="anexos_ventas_id" >
                                     <tree>
                                            <field name="name" invisible="0"></field>
                                     </tree>
