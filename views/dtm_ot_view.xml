                            <page string="RESUMEN">
                                <group>
                                    <field name="description"/>
                                </group>
                            </page>
                            <page string="MATERIALES" attrs="{'invisible': [('tipe_order','in',['Pre','PD','SK'])]}">
                                <field name="lista_material_id"  attrs="{'readonly': [('retrabajo', '=', True)]}">
<!--                                <field name="lista_material_id">-->
                                    <tree editable="bottom" >
                                        <field name="material_id"  create="false" delete="false"/>
                                        <field name="cantidad" options='{"type": "number"}' />
                                        <field name="currency_id" invisible="1"/>
                                        <field name="unitario"/>
                                        <field name="precio" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </tree>
                                </field>
                                <div class="d-flex justify-content-between">
<!--                                    <button type="object" name="action_almacen" string=""  icon="fa-eye" title="pencil" class="btn btn-primary" attrs="{'invisible': [('firma_ingenieria', '!=', 'Bryan Banda')]}"/>-->
                                    <field name="costo_diseno"/>
                                </div>
                            </page>
                            <page string="INGENIERÍA" attrs="{'invisible': [('tipe_order','in',['SK','PD','Pre','COT'])]}">
                                <field name="materials_ids"  >
                                    <tree editable="bottom" decoration-success="entregado"
                                        decoration-info="revision and not entregado"
                                        decoration-bf="revision or entregado" >
                                        <field name="materials_list" attrs="{'readonly': [('revision', '=', True)]} " create="false" delete="false"/>
                                        <field name="notas"/>
                                        <field name="materials_cuantity" options='{"type": "number"}' attrs="{'readonly': [('revision', '=', True)]}"/>
                                        <field name="materials_availabe" options="{'no_create': True, 'no_delete': True}"/>
                                        <field name="materials_required" options='{"type": "number"}'/>
                                        <field name="costo"/>
                                        <field name="almacen"/>
                                        <field name="revision" attrs="{'readonly': [('usuario', '!=', 'ingenieria1@dtmindustry.com')]}"/>
                                        <field name="entregado" invisible="1"/>
                                        <field name="recibe" invisible="1"/>
                                        <field name="usuario" invisible="1"/>
                                    </tree>
                                </field>
                                 <field name="costo_material"/>
                            </page>
                            <page string="RECHAZO" attrs="{'invisible': [('tipe_order','in',['SK','PD','Pre'])]}">
                                <field name="rechazo_id" attrs="{'readonly': [('retrabajo', '=', True)]}">
                                    <tree editable="bottom">
                                        <field name="descripcion"/>
                                        <field name="fecha"/>
                                        <field name="hora"/>
                                        <field name="firma"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="PLANOS" attrs="{'invisible': [('tipe_order','in',['SK','PD','Pre'])]}">
                                <field name="anexos_id" widget="many2many_binary" attrs="{'readonly': [('retrabajo', '=', True)]}"/>
                            </page>
                            <page string="CORTADORA" attrs="{'invisible': [('tipe_order','in',['SK','PD','Pre','COT'])]}">
                                <group>
                                    <group class="d-flex flex-column">
                                        <field name="primera_pieza_id">
                                            <tree>
                                                <field name="nombre"/>
                                                <field name="material_ids"/>
                                                <field name="cantidad"/>
                                                <field name="maquina" />
                                            </tree>
                                            <form>
                                                <group editable="bottom">
                                                    <field name="archivo" filename="nombre" />
                                                    <field name="nombre" invisible="1"/>
                                                    <field name="material_ids" create="0"/>
                                                    <field name="filtro" invisible="1"/>
                                                    <field name="cantidad" options='{"type": "number"}'/>
                                                    <field name="maquina" />
                                                </group>
                                            </form>
                                        </field>
                                    </group>

                                    <group class="d-flex flex-column">
                                        <field name="cortadora_id">
<!--                                               attrs="{'readonly': ['|',('firma_ingenieria','!=',False),('usuario','!=','ingenieria1@dtmindustry.com')]}">-->
                                            <tree>
                                                <field name="nombre"/>
                                                <field name="material_ids"/>
                                                <field name="cantidad"/>
                                                <field name="maquina" />
                                            </tree>
                                            <form>
                                                <group editable="bottom">
                                                    <field name="archivo" filename="nombre" />
                                                    <field name="nombre" invisible="1"/>
                                                    <field name="material_ids" create="0"/>
                                                    <field name="filtro" invisible="1"/>
                                                    <field name="cantidad" options='{"type": "number"}'/>
                                                    <field name="maquina" />
                                                </group>
                                            </form>
                                        </field>
                                    </group>
                                </group>

                                <div class="o_row">
                                    <field name="ligas_id">
                                        <tree editable="bottom">
                                            <field name="liga"/>
                                        </tree>
                                    </field>
                                </div>
                            </page>
<!--                            <page string="BFC6025" attrs="{'invisible': [('tipe_order','in',['SK','PD','Pre','COT'])]}">-->
<!--                                <div style="display:flex;">-->
<!--                                    <div style="display:flex;width: 50%">-->
<!--                                        <field name="primera_pieza_bfc_id" widget="many2many_binary" attrs="{'readonly': ['|',('firma_ingenieria', '!=', False),('usuario', '!=', 'ingenieria1@dtmindustry.com')]}"/>-->
<!--                                        <field name="bfc_id" widget="many2many_binary" attrs="{'readonly': ['|',('firma_ingenieria', '!=', False),('usuario', '!=', 'ingenieria1@dtmindustry.com')]}"/>-->
<!--                                    </div>-->
<!--                                    <div style="width: 50%">-->
