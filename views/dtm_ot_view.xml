                            <page string="RETRABAJO" attrs="{'invisible': [('usuario','not in',['calidad2@dtmindustry.com','rafaguzmang@hotmail.com'])]}">
                                <field name="bitacora_id"/>
                            </page>
                        </notebook>
                    </sheet>
