<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="dtm_odt.dtm_ot_action" model="ir.actions.act_window">
            <field name="name">Diseño</field>
            <field name="res_model">dtm.odt</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_diseno': True}</field>
        </record>

        <record id="dtm_ot_search" model="ir.ui.view">
            <field name="name">dtm_ot_search</field>
            <field name="model">dtm.odt</field>
            <field name="arch" type="xml">
               <search>
                    <field name="ot_number"/>
                    <field name="od_number"/>
                    <field name="name_client"/>
                    <field name="disenador"/>
                    <field name="po_number"/>
                    <!-- Filtros por tipo de orden -->
                    <filter string="OT" name="ot" domain="[('tipe_order','=','OT')]"/>
                    <filter string="NPI" name="npi" domain="[('tipe_order','=','NPI')]"/>
                    <filter string="SK" name="sk" domain="[('tipe_order','=','SK')]"/>
                    <filter string="ODT-I" name="odt-i" domain="[('tipe_order','=','ODT-I')]"/>
                    <filter string="PD" name="PD" domain="[('tipe_order','=','PD')]"/>
                    <filter string="Versión" name="PD" domain="[('version_ot','>',1)]"/>
                    <separator/>
                    <!-- Filtros por firma de ventas -->
                    <filter string="En diseño" name="diseno" domain="[ '|',('manufactura', '=', False),('nesteo_chk','=',True)]"/>


               </search>
            </field>
        </record>

        <record id="dtm_ot_tree" model="ir.ui.view">
            <field name="name">dtm.odt.tree</field>
            <field name="model">dtm.odt</field>
            <field name="arch" type="xml">
                <tree  >
                    <field name="od_number"/>
                    <field name="ot_number"/>
                    <field name="revision_ot"/>
                    <field name="version_ot"/>
                    <field name="tipe_order"/>
                    <field name="po_number"/>
                    <field name="po_fecha"/>
                    <field name="po_fecha_creacion"/>
                    <field name="date_disign_finish" widget="date"/>
                    <field name="name_client"/>
                    <field name="product_name"/>
                    <field name="disenador"/>
                    <field name="firma"/>
                    <field name="firma_ventas"/>
                    <field name="manufactura"/>
                    <field name="nesteo_chk" />
                </tree>
            </field>
        </record>

        <record id="dtm_ot_form" model="ir.ui.view">
            <field name="name">dtm.odt.form</field>
            <field name="model">dtm.odt</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button type="object" name="action_version" string="Nueva versión"  icon="fa-file-text-o" title="pencil" class="btn btn-warning" /> />
                        <button type="object" name="action_imprimir_formato" string="ODT" icon="fa-print" class="btn btn-primary"/>
                        <button type="object" name="action_imprimir_materiales" string="Lista de Materiales" icon="fa-print"  class="btn btn-primary" title="print"/>
                        <button type="object" name="action_firma" string="Firma"  icon="fa-pencil" title="pencil" class="btn btn-primary" attrs="{'invisible': [('retrabajo', '=', True), ('firma_ventas', '=', True)]}" />
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_pasive" type="object" string="Anexos" class="oe_stat_button" icon="fa-calendar">
                                <field name="date_rel"  string="" widget="statinfo"/>
                            </button>
                            <button name="action_pasive" type="object" string="Cliente" class="oe_stat_button" icon="fa-user">
                                <field name="name_client"  string="" widget="statinfo"/>
                            </button>
                            <button name="action_pasive" type="object" string="tipo" class="oe_stat_button" icon="fa-paperclip">
                                <field name="orden_compra_pdf"  string="" widget="statinfo"/>
                            </button>
                            <button name="action_pasive" type="object" string="tipo" class="oe_stat_button" icon="fa-certificate">
                                <field name="firma_ventas"  string="" widget="statinfo"/>
                            </button>
                            <button name="action_pasive" type="object" string="tipo" class="oe_stat_button" icon="fa-pencil">
                                <field name="firma"  string="" widget="statinfo"/>
                            </button>
                            <button name="action_pasive" type="object" string="tipo" class="oe_stat_button" icon="fa-shield">
                                <field name="firma_ingenieria"  string="" widget="statinfo"/>
                            </button>
                            <button name="action_pasive" type="object" string="Anexos" class="oe_stat_button" icon="fa-clipboard">
                                <field name="tipe_order"  string="" widget="statinfo"/>
                            </button>
                            <button name="action_pasive" type="object" string="tipo" class="oe_stat_button" icon="fa-envelope">
                                <field name="po_number"  string="" widget="statinfo"/>
                            </button>
                             <button name="action_pasive" type="object" string="Anexos" class="oe_stat_button" icon="fa-calendar">
                                <field name="date_in"  string="" widget="statinfo"/>
                            </button>
                        </div>
                            <div class="row" style="padding-bottom: 15px;">
                                <div class="col-6">
                                    <h1>
                                        <field name="product_name" attrs="{'readonly': [('tipe_order', '=', 'OT')]}" />
                                    </h1>
                                </div>
                                 <div class="col-6">
                                    <h1>
                                        <field name="name_client" attrs="{'invisible': [('tipe_order', '!=', 'NPI')]}" />
                                    </h1>
                                </div>
                            </div>
                        <div class="row d-flex justify-content-between">
                            <group class="col-4">
                                    <field name="date_rel" attrs="{'invisible': [('tipe_order', '!=', 'NPI')]}"/>
                                    <field name="version_ot"  options='{"type": "number"}'/>
                                    <field name="revision_ot"  options='{"type": "number"}'/>
                                    <field name="cuantity" options='{"type": "number"}' attrs="{'readonly': [('ot_number', '=', 'OT')]}"/>
                                    <field name="color"/>
                                    <field name="firma_almacen"/>
                            </group>
                            <group class="col-4">
                                    <field name="intervencion_calidad"/>
                                    <field name="firma_calidad"/>
                            </group>

                        </div>
                                <field name="po_number" invisible="1"/>
                                <field name="firma_ventas" attrs="{'invisible': ['|',('tipe_order','=','SK'),('tipe_order','=','PD')]}" invisible="1"/>
                                <field name="firma_ingenieria" attrs="{'invisible': ['|',('tipe_order','=','SK'),('tipe_order','=','PD')]}" invisible="1"/>
                                <field name="tipe_order" invisible="1"/>
                                <field name="ot_number" invisible="1"/>
                                <field name="retrabajo" invisible="1"/>
                                <field name="firma" invisible="1"/>
                        <notebook>
                            <page  string="RESUMEN">
                                <group>
                                    <field name="description"/>
                                </group>
                            </page>

                            <page string="MATERIALES" attrs="{'invisible': ['|',('tipe_order','=','SK'),('tipe_order','=','PD')]}">

                                <field name="materials_ids"  attrs="{'readonly': [('retrabajo', '=', True)]}">
                                    <tree editable="bottom" decoration-success="entregado"
                                        decoration-info="revision and not entregado"
                                        decoration-bf="revision or entregado" >
                                        <field name="materials_list" attrs="{'readonly': [('revision', '=', True)]} " create="false" delete="false"/>
                                        <field name="notas"/>
                                        <field name="materials_cuantity" options='{"type": "number"} ' attrs="{'readonly': [('revision', '=', True)]}" />
                                        <field name="materials_availabe" options="{'no_create': True, 'no_delete': True}"/>
                                        <field name="materials_required" options='{"type": "number"}'/>
                                        <field name="costo"/>
                                        <field name="almacen"  attrs="{'readonly': [('usuario', '!=', 'ingenieria1@dtmindustry.com')]}"/>
                                        <field name="revision" attrs="{'readonly': [('usuario', '!=', 'ingenieria1@dtmindustry.com')]}"/>
                                        <field name="entregado" invisible="1"/>
                                        <field name="recibe" invisible="1"/>
                                        <field name="usuario" invisible="1"/>
                                    </tree>
                                </field>
                                <div class="d-flex justify-content-between">
                                    <button type="object" name="action_almacen" string=""  icon="fa-eye" title="pencil" class="btn btn-primary" attrs="{'invisible': [('firma_ingenieria', '!=', 'Bryan Banda')]}"/>
                                    <field name="costo_material"/>
                                </div>
                            </page>
                            <page string="RECHAZO" attrs="{'invisible': ['|',('tipe_order','=','SK'),('tipe_order','=','PD')]}">
                                <field name="rechazo_id" attrs="{'readonly': [('retrabajo', '=', True)]}">
                                    <tree editable="bottom">
                                        <field name="descripcion"/>
                                        <field name="fecha"/>
                                        <field name="hora"/>
                                        <field name="firma"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="PLANOS" attrs="{'invisible': ['|',('tipe_order','=','SK'),('tipe_order','=','PD')]}">
                                <field name="anexos_id" widget="many2many_binary" attrs="{'readonly': [('retrabajo', '=', True)]}"/>

                            </page>
                            <page string="MITSUBISHI" attrs="{'invisible': ['|',('tipe_order','=','SK'),('tipe_order','=','PD')]}">
                                <div style="display:flex;">
                                    <div style="display:flex;width: 50%">
                                        <field name="primera_pieza_id" widget="many2many_binary" attrs="{'readonly': [('retrabajo', '=', True)]}"/>
                                        <field name="cortadora_id" widget="many2many_binary" attrs="{'readonly': [('retrabajo', '=', True)]}"/>
                                    </div>
                                    <div style="width: 50%">
                                        <field name="ligas_id"  >
                                            <tree editable="bottom">
                                                <field name="liga"/>
                                            </tree>
                                        </field>
                                    </div>
                                </div>
                            </page>
                            <page string="LTP 6032"  attrs="{'invisible': ['|',('tipe_order','=','SK'),('tipe_order','=','PD')]}">
                                 <div style="display:flex;">
                                    <div style="display:flex;width: 50%">
                                        <field name="tubos_id" widget="many2many_binary" attrs="{'readonly': [('retrabajo', '=', True)]}" />
                                    </div>
                                    <div style="width: 50%">
                                        <field name="ligas_tubos_id"  >
                                            <tree editable="bottom">
                                                <field name="liga"/>
                                            </tree>
                                        </field>
                                    </div>
                                </div>

                            </page>
                            <page string="NOTAS">
                                <field name="notes"/>
                            </page>
                            <page string="PO" attrs="{'invisible': [('usuario','=','ingenieria1@dtmindustry.com')]}">
                                <group>
                                    <field name="usuario" invisible="1"/>
                                </group>
                                <field name="orden_compra_pdf" >
                                     <tree>
                                            <field name="name" invisible="0"></field>
                                     </tree>
                                     <form>
                                        <group >
                                            <field name="datas" filename="nombre" widget="pdf_viewer"></field>
                                            <field name="name" invisible="1"></field>
                                        </group>
                                     </form>
                                </field>
                            </page>
                            <page string="ARCHIVOS" attrs="{'invisible': [('usuario','=','ingenieria1@dtmindustry.com')]}">
                                <group>
                                    <field name="usuario" invisible="1"/>
                                </group>
                                <field name="anexos_ventas_id" >
                                     <tree>
                                            <field name="name" invisible="0"></field>
                                     </tree>
                                     <form>
                                        <group >
                                            <field name="datas" filename="nombre" widget="pdf_viewer"></field>
                                            <field name="name" invisible="1"></field>
                                        </group>
                                     </form>
                                </field>
                            </page>
                            <page string="SERVICIOS" attrs="{'invisible': ['|',('tipe_order','=','SK'),('tipe_order','=','PD')]}">
                                <field name="maquinados_id">
                                    <tree>
                                        <field name="tipo_servicio"/>
                                        <field name="nombre"/>
                                        <field name="cantidad"/>
                                        <field name="proveedor"/>
                                        <field name="fecha_solicitud"/>
                                        <field name="fecha_compra"/>
                                        <field name="fecha_entrada"/>
                                    </tree>
                                    <form>
                                        <div class="flex-fechas">
                                            <div class="flex-fecha">
                                                <i class="fa fa-calendar"></i>
                                                <div class="flex-content">
                                                    <field name="fecha_solicitud"/>
                                                    <p class="calendar-text">Solicitud</p>
                                                </div>
                                            </div>
                                            <div class="flex-fecha">
                                                <i class="fa fa-calendar"></i>
                                                    <div class="flex-content">
                                                        <field name="fecha_compra"/>
                                                        <p class="calendar-text">Compra</p>
                                                    </div>
                                            </div>
                                            <div class="flex-fecha">
                                                <i class="fa fa-calendar"></i>
                                                 <div class="flex-content">
                                                    <field  name="fecha_entrada"/>
                                                    <p class="calendar-text">Entrada</p>
                                                </div>
                                            </div>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="tipo_servicio"/>
                                                <field name="nombre"/>
                                                <field name="cantidad" options='{"type": "number"}'/>
                                            </group>
<!--                                            <group>-->
<!--                                                <field name="fecha_solicitud"/>-->
<!--                                                <field name="fecha_compra"/>-->
<!--                                                <field name="fecha_entrada"/>-->
<!--                                            </group>-->
                                        </group>
                                        <notebook>
                                            <page string="Materiales">
                                                <field name="material_id">
                                                      <tree editable="bottom" >
                                                        <field name="materials_list"/>
                                                        <field name="notas"/>
                                                        <field name="materials_cuantity" options='{"type": "number"} ' attrs="{'invisible': [('materials_list', '=', False)]}"/>
                                                        <field name="materials_availabe"/>
                                                        <field name="materials_required" options='{"type": "number"}'/>
                                                        <field name="revision"/>
                                                    </tree>
                                                </field>
                                            </page>
                                            <page string="Anexos">
                                                <field name="anexos_id" widget="many2many_binary"/>
                                            </page>
                                        </notebook>

                                    </form>
                                </field>

                            </page>
                            <page string="ANEXOS">
                                <field name="archivos_id"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>

            </field>
        </record>

    </data>
</odoo>
