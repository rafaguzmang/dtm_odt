<template id="template" xml:space="preserve">
    <t t-name="dtm_odt.modulo_nesteo" owl="1">
        <div class="odt-panel">

            <!-- HEADER -->
            <header class="odt-header">
                <div class="odt-header__left">
                    <div class="odt-logo-row">
                        <div class="odt-logo-dot"></div>
                        <h1 class="odt-header__title">Nesteo</h1>
                    </div>
                    <span class="odt-subtitle">Panel de seguimiento · Área de Diseño</span>
                </div>
                <div class="odt-header__meta">
                    <div class="odt-badge">
                        <span class="odt-badge__dot"></span>
                        Sistema activo
                    </div>
                    <div class="odt-badge"><t t-esc="new Date().toLocaleDateString()"/></div>
                </div>
            </header>

            <!-- TABLE SECTION -->
            <div class="odt-table-section">

                <div class="odt-table-header">
                    <h2 class="odt-table-header__title">Registro de Órdenes de Diseño</h2>
                </div>

                <div class="odt-table-wrap">
                    <table class="odt-table">
                        <thead>
                            <tr>
                                <th>OT<span class="odt-sort-icon">↕</span></th>
                                <th>Versión<span class="odt-sort-icon">↕</span></th>
                                <th>Tipo<span class="odt-sort-icon">↕</span></th>
                                <th>Cliente<span class="odt-sort-icon">↕</span></th>
                                <th>Producto<span class="odt-sort-icon">↕</span></th>
                                <th>Cantidad<span class="odt-sort-icon">↕</span></th>
                                <th>Diseñador<span class="odt-sort-icon">↕</span></th>
                                <th>En Nesteo<span class="odt-sort-icon">↕</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data" t-as="item" t-key="item.id">
                                <tr>
                                    <td><span class="odt-ref-badge"><t t-esc="item.ot_number"/></span></td>
                                    <td><span class="odt-chip"><t t-esc="item.version_ot"/></span></td>
                                    <td><t t-esc="item.tipo_orden"/></td>
                                    <td><t t-esc="item.cliente"/></td>
                                    <td class="odt-td--producto"><t t-esc="item.producto"/></td>
                                    <td class="odt-td--cantidad"><t t-esc="item.cantidad"/></td>
                                    <td class="odt-td--disenador"><t t-esc="item.disenador"/></td>
                                    <td class="odt-td--fecha"><t t-esc="item.fecha_llegada"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div><!-- /odt-table-section -->

        </div><!-- /odt-panel -->
    </t>
</template>