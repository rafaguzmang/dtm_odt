<template xml:space="preserve">
    <t t-name="dtm_odt.modulo_diseno" owl="1">
      <div class="dc-wrapper">

        <!-- HEADER -->
        <header class="dc-header">
            <div class="dc-header__left">
            <div class="dc-logo-row">
                <div class="dc-logo-dot"></div>
                <h1 class="dc-header__title">Design Control</h1>
            </div>
            <span class="dc-subtitle">Panel de seguimiento · Área de Diseño</span>
            </div>
            <div class="dc-header__meta">
            <div class="dc-badge">
                <span class="dc-badge__dot"></span>
                Sistema activo
            </div>
            <!-- Fecha dinámica: reemplazar con t-out en OWL -->
            <div class="dc-badge"><t t-esc="new Date().toLocaleDateString()"/></div>
            </div>
        </header>

        <!-- KPIs -->
        <div class="dc-kpi-grid">

            <div class="dc-kpi">
                <div class="dc-kpi__label">Total ODs</div>
                <!-- t-out="state.kpiTotal" -->
                <div class="dc-kpi__value"><t t-esc="this.state.kpiTotal"/></div>
                <div class="dc-kpi__sub">registros activos</div>
                <div class="dc-kpi__bar">
                    <div class="dc-kpi__bar-fill" style="background:var(--dc-accent); width:100%"></div>
                </div>
            </div>

            <div class="dc-kpi">
                <div class="dc-kpi__label">En Tiempo</div>
                <div class="dc-kpi__value"><t t-esc="this.state.kpiOdTiempo"/></div>
                <div class="dc-kpi__sub">órdenes de trabajo</div>
                <div class="dc-kpi__bar">
                    <div class="dc-kpi__bar-fill" t-att-style="state.styleBarraTiempo"></div>
                </div>
            </div>

            <div class="dc-kpi">
                <div class="dc-kpi__label">Fuera de Tiempo</div>
                <div class="dc-kpi__value"><t t-esc="this.state.kpiOdFueraTiempo"/></div>
                <div class="dc-kpi__sub">órdenes de trabajo</div>
                <div class="dc-kpi__bar">
                    <div class="dc-kpi__bar-fill" t-att-style="state.styleBarraFueraTiempo"></div>
                </div>
            </div>

            <div class="dc-kpi">
                <div class="dc-kpi__label">Clientes</div>
                <div class="dc-kpi__value"><t t-esc="this.state.kpiClientes"/></div>
                <div class="dc-kpi__sub">distintos</div>
                <div class="dc-kpi__bar">
                    <div class="dc-kpi__bar-fill" style="background:var(--dc-green); width:100%"></div>
                </div>
            </div>
        </div>

