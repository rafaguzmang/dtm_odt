<template xml:space="preserve">
    <t t-name="dtm_odt.modulo_diseno" owl="1">
      <div class="odt-panel">

        <!-- HEADER -->
        <header class="odt-header">
            <div class="odt-header__left">
            <div class="odt-logo-row">
                <div class="odt-logo-dot"></div>
                <h1 class="odt-header__title">Design Control</h1>
            </div>
            <span class="odt-subtitle">Panel de seguimiento · Área de Diseño</span>
            </div>
            <div class="odt-header__meta">
            <div class="odt-badge">
                <span class="odt-badge__dot"></span>
                Sistema activo
            </div>
            <!-- Fecha dinámica: reemplazar con t-out en OWL -->
            <div class="odt-badge"><t t-esc="new Date().toLocaleDateString()"/></div>
            </div>
        </header>

        <!-- KPIs -->
        <div class="odt-kpi-grid">

            <div class="odt-kpi">
                <div class="odt-kpi__label">Total ODs</div>
                <!-- t-out="state.kpiTotal" -->
                <div class="odt-kpi__value"><t t-esc="this.state.kpiTotal"/></div>
                <div class="odt-kpi__sub">registros activos</div>
                <div class="odt-kpi__bar">
                    <div class="odt-kpi__bar-fill" style="background:var(--odt-primary); width:100%"></div>
                </div>
            </div>

            <div class="odt-kpi">
                <div class="odt-kpi__label">En Tiempo</div>
                <div class="odt-kpi__value"><t t-esc="this.state.kpiOdTiempo"/></div>
                <div class="odt-kpi__sub">órdenes de trabajo</div>
                <div class="odt-kpi__bar">
                    <div class="odt-kpi__bar-fill" t-att-style="state.styleBarraTiempo"></div>
                </div>
            </div>

            <div class="odt-kpi">
                <div class="odt-kpi__label">Fuera de Tiempo</div>
                <div class="odt-kpi__value"><t t-esc="this.state.kpiOdFueraTiempo"/></div>
                <div class="odt-kpi__sub">órdenes de trabajo</div>
                <div class="odt-kpi__bar">
                    <div class="odt-kpi__bar-fill" t-att-style="state.styleBarraFueraTiempo"></div>
                </div>
            </div>

            <div class="odt-kpi">
                <div class="odt-kpi__label">Clientes</div>
                <div class="odt-kpi__value"><t t-esc="this.state.kpiClientes"/></div>
                <div class="odt-kpi__sub">distintos</div>
                <div class="odt-kpi__bar">
                    <div class="odt-kpi__bar-fill" style="background:var(--odt-success); width:100%"></div>
                </div>
            </div>
        </div>

