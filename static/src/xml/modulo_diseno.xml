        <!-- TABLE SECTION -->
        <div class="odt-table-section">

            <div class="odt-table-header">
                <h2 class="odt-table-header__title">Registro de Órdenes de Diseño</h2>
                <div class="odt-controls">
                    <input class="odt-search" type="number" id="odt-search-input"
                        t-on-change="(ev) => this.searchODT(ev)"
                        placeholder="Buscar Órden de Diseño"/>

                    <select class="odt-select" id="odt-filter-client"
                        name="cliente_filtro"
                        t-on-change="(ev) => this.clienteFiltro(ev)">
                        <option value="">Todos los clientes</option>
                        <t t-foreach="state.clients" t-as="cliente" t-key="cliente">
                            <option t-att-value="cliente">
                                <t t-esc="cliente"/>
                            </option>
                        </t>
                    </select>
                    <select class="odt-select" id="odt-filter-producto"
                        name="producto_filtro"
                        t-on-change="(ev) => this.productoFiltro(ev)">
                        <option value="">Todos los productos</option>
                        <t t-foreach="state.productos" t-as="producto" t-key="producto">
                            <option t-att-value="producto">
                                <t t-esc="producto"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

            <div class="odt-table-wrap">
            <table class="odt-table">
                <thead>
                <tr>
                    <th t-on-click="() => this.sortColumn('orden_diseno')">OD <span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('cliente')">Cliente <span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('producto')">Producto <span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('cantidad')">Cantidad <span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('disenador')">Diseñador <span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('po_number')">PO<span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('precio')">Precio MXN<span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('fecha_llegada')">En Diseño<span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('fecha_termino_diseno')">Fecha Estimada <span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('fecha_entrega_cliente')">Fecha Entrega<span class="odt-sort-icon">↕</span></th>
                    <th t-on-click="() => this.sortColumn('diseno_duracion')">Duración<span class="odt-sort-icon">↕</span></th>
                </tr>
                </thead>
                <tbody id="odt-tbody">
                    <t t-foreach="state.ordenes" t-as="orden" t-key="orden.id">
                        <tr>
                            <td><span class="odt-ref-badge"><t t-esc="orden.orden_diseno"/></span></td>
                            <td><span class="odt-chip"><t t-esc="orden.cliente"/></span></td>
                            <td class="odt-td--producto"><t t-esc="orden.producto"/></td>
                            <td class="odt-td--cantidad"><t t-esc="orden.cantidad"/></td>
                            <td class="odt-td--disenador"><t t-esc="orden.disenador"/></td>
                            <td class="odt-td--po odt-td--popdf" t-on-click="()=> this.openPDF(orden.po_file)"><t t-esc="orden.po_number"/></td>
                            <td class="odt-td--po"><t t-esc="orden.precio"/></td>
                            <td class="odt-td--fecha"><t t-esc="orden.fecha_llegada"/></td>
                            <td class="odt-td--fecha">
                                <t t-if="orden.fecha_termino_diseno">
                                    <span t-att-class="new Date(orden.fecha_termino_diseno) &lt; new Date()
                                        ? 'odt-fecha-badge odt-fecha-badge--vencida'
                                        : 'odt-fecha-badge odt-fecha-badge--ok'">
                                        <t t-if="new Date(orden.fecha_termino_diseno) &lt; new Date()">⚠</t>
                                        <t t-else="">✓</t>
                                        <t t-esc="orden.fecha_termino_diseno"/>
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="odt-vacio">—</span>
                                </t>
                            </td>
                            <td class="odt-td--fecha"><t t-esc="orden.fecha_entrega_cliente"/></td>
                            <td class="odt-td--duracion"><t t-esc="orden.diseno_duracion"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
            </div>

            <t t-if="state.showPDF">
                <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-xl">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">PO</h5>
                                <button type="button" class="btn-close" aria-label="Close" t-on-click="closePDF"></button>
                            </div>
                            <div class="modal-body">
                                <iframe
                                    t-att-src="'data:application/pdf;base64,' + state.currentPDF"
                                    class="odt-pdf-iframe"
                                    type="application/pdf">
                                </iframe>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" t-on-click="closePDF">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

        </div><!-- /odt-table-section -->

      </div><!-- /odt-panel -->
    </t>
</template>